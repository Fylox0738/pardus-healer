<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Pardus OS</vendor>
  <vendor_url>https://pardus.org.tr</vendor_url>

  <action id="org.pardus.healer.fix">
    <description>Pardus Healer Otonom Onarım Yetkisi</description>
    <description xml:lang="tr">Pardus Healer Otonom Onarım Yetkisi</description>
    <message>Sistem onarımı için yetki gerekiyor</message>
    <message xml:lang="tr">Pardus Healer sisteminizi onarmak için yetki istiyor.</message>
    <defaults>
      <!-- Kullanıcı aktif (yerel) oturumdaysa parola sormadan izin ver (Native hissi için) -->
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/pardus-suite/run.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
